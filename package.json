{
  "name": "grove-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/identity": "^4.12.0",
    "@azure/storage-blob": "^12.29.0",
    "@mozilla/readability": "^0.6.0",
    "@tiptap/extension-link": "^3.4.0",
    "@tiptap/extension-placeholder": "^3.4.0",
    "@tiptap/react": "^3.4.0",
    "@tiptap/starter-kit": "^3.4.0",
    "archiver": "^7.0.1",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.4.0",
    "csv-parse": "^7.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "fast-xml-parser": "^5.2.5",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.2.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.10.0",
    "multer": "^2.0.2",
    "openai": "^6.0.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.1",
    "recharts": "^3.2.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.0",
    "undici": "^7.16.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^21.1.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.10",
    "playwright": "^1.55.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^7.1.7"
  },
  "description": "Self-hosted research, writing and reviewed publishing workspace",
  "license": "MIT"
}
